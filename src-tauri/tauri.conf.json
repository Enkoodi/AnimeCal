{
  "$schema": "https://schema.tauri.app/config/2",
  "identifier": "com.animecal.desktop",
  "productName": "番剧日历",
  "version": "1.0.0",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https: http://lain.bgm.tv https://lain.bgm.tv; connect-src 'self' https:"
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
